pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        POSTGRES_DB       = 'forkity'
        POSTGRES_USER     = 'forkity'
        POSTGRES_PASSWORD = '7ccc9610b6a4db9b2d6506bcdc7204e1bb01fa097245292824ee09f271e68010'
        FORKITY_PORT      = '9090'
    }
    stages {
        stage('Clean workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        // stage('Prepare Jenkins agent') {
        //     steps {
        //         dir('forkity-cicd') {
        //             sh 'sudo bash scripts/prepare-jenkins-ubuntu24.sh'
        //         }
        //     }
        // }
        stage('Verify Jenkins agent') {
            steps {
                dir('forkity-cicd') {
                    sh 'bash scripts/verify-jenkins-ubuntu24.sh'
                }
            }
        }
        stage('Install dependencies') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm ci'
                }
            }
        }
        stage('Build frontend') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm run build'
                }
            }
        }
        stage('Prepare Compose environment') {
            steps {
                dir('forkity-cicd') {
                    sh '''
                    if [ ! -f .env ]; then
                        printf '%s\n' \
                        "POSTGRES_DB=${POSTGRES_DB}" \
                        "POSTGRES_USER=${POSTGRES_USER}" \
                        "POSTGRES_PASSWORD=${POSTGRES_PASSWORD}" \
                        "FORKITY_PORT=${FORKITY_PORT}" > .env
                    fi
                    '''
                }
            }
        }
        stage('Validate Compose') {
            steps {
                dir('forkity-cicd') {
                    sh 'docker compose config --quiet'
                }
            }
        }
        stage('Build container images') {
            steps {
                dir('forkity-cicd') {
                    sh 'docker compose build'
                }
            }
        }
        stage('Start application') {
            steps {
                dir('forkity-cicd') {
                    sh 'npm run container:up'
                }
            }
        }
        stage('Verify application') {
            steps {
                dir('forkity-cicd') {
                    sh '''
                    docker compose ps
                    node -e '
                    const url = `http://127.0.0.1:${process.env.FORKITY_PORT}/`;
                    let attempts = 0;
                    const check = async () => {
                        attempts += 1;
                        try {
                            const response = await fetch(url);
                            if (!response.ok) process.exit(1);
                        } catch (error) {
                            if (attempts >= 10) {
                                console.error(error);
                                process.exit(1);
                            }
                            setTimeout(check, 3000);
                        }
                    };
                    check();
                    '
                    '''
                }
            }
        }
    }
    post {
        failure {
            dir('forkity-cicd') {
                sh 'docker compose logs --no-color --tail=100 || true'
                sh 'docker compose ps'
                sh 'docker compose logs backend --tail=200'
                sh 'docker compose logs db --tail=200'
            }
        }
        success {
            dir('forkity-cicd') {
                sh 'docker compose down --volumes --remove-orphans --rmi local'
            }
        }
        always {
            dir('forkity-cicd') {
                sh 'docker compose ps || true'
            }
        }
    }
}
